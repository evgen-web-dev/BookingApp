{
  "outputStyle": "Tutor",
  "autoUpdatesChannel": "stable",
  "autoMemoryEnabled": false,
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "blockReadsOutsideWorkingDirectories": true,
    "allow": [
      "Edit(**/docs/learning/decisions.md)",
      "Edit(**/docs/learning/debt.md)",
      "Edit(**/docs/learning/handoff.md)",
      "Edit(**/docs/learning/reviews/**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git merge-base:*)",
      "Bash(git rev-parse:*)",
      "Bash(git for-each-ref:*)",
      "Bash(dotnet --info)",
      "Bash(dotnet --list-sdks)"
    ],
    "ask": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet run:*)",
      "Bash(dotnet watch:*)",
      "Bash(dotnet publish:*)",
      "Bash(curl:*)",
      "Bash(sqlcmd:*)",
      "Bash(docker:*)",
      "Bash(docker compose:*)",
      "Bash(psql:*)"
    ],
    "deny": [
      "Agent",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/*.cs)",
      "Edit(**/*.csx)",
      "Edit(**/*.fs)",
      "Edit(**/*.fsx)",
      "Edit(**/*.vb)",
      "Edit(**/*.razor)",
      "Edit(**/*.cshtml)",
      "Edit(**/*.vbhtml)",
      "Edit(**/*.csproj)",
      "Edit(**/*.fsproj)",
      "Edit(**/*.vbproj)",
      "Edit(**/*.sln)",
      "Edit(**/*.slnx)",
      "Edit(**/*.props)",
      "Edit(**/*.targets)",
      "Edit(**/*.ruleset)",
      "Edit(**/Migrations/**)",
      "Edit(**/appsettings*.json)",
      "Edit(**/launchSettings.json)",
      "Edit(**/global.json)",
      "Edit(**/nuget.config)",
      "Edit(**/package.json)",
      "Edit(**/package-lock.json)",
      "Edit(./.git/**)",
      "Edit(./.devcontainer/**)",
      "Edit(./.claude/**)",
      "Bash(dotnet new:*)",
      "Bash(dotnet add:*)",
      "Bash(dotnet remove:*)",
      "Bash(dotnet sln:*)",
      "Bash(dotnet nuget:*)",
      "Bash(dotnet ef migrations add:*)",
      "Bash(dotnet ef migrations remove:*)",
      "Bash(dotnet ef database update:*)",
      "Bash(dotnet ef database drop:*)",
      "Bash(dotnet format:*)",
      "Bash(dotnet user-secrets:*)",
      "Bash(dotnet aspnet-codegenerator:*)",
      "Bash(dotnet tool install:*)",
      "Bash(dotnet tool update:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git restore:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git stash:*)",
      "Bash(git clean:*)",
      "Bash(git branch:*)",
      "Bash(git tag:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git revert:*)",
      "Bash(gh:*)",
      "Bash(az:*)",
      "Bash(sudo:*)",
      "Bash(npm install:*)",
      "Bash(npm exec:*)",
      "Bash(npx:*)"
    ]
  }
}